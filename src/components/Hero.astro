---
---
<section class="hero bg-navy relative overflow-hidden flex items-center min-h-[90vh]">
  <div class="hero-glow-1"></div>
  <div class="hero-glow-2"></div>
  
  <div class="container relative z-10 hero-grid">
    <div class="hero-content animate-fade-left">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        A special tribute from Batch 2026
      </div>
      <h1 class="hero-title">
        Happy Birthday <br />
        <span class="text-gradient-gold italic">SK Chaudhary Sir</span>
      </h1>
      <p class="hero-description">
        Founder of CodeYogi & Co-Founder of Safex Group. Your vision is the light that guides us toward a brighter future in tech.
      </p>
      <div class="hero-actions">
        <a href="#gallery" class="btn-primary">
          <span>View Gallery</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <a href="#videos" class="btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span>Watch Wishes</span>
        </a>
      </div>
    </div>
    
    <div class="hero-image-container animate-fade-right delay-2">
      <div class="image-frame animate-float">
        <img src="/sir.png" alt="SK Chaudhary Sir" class="hero-img" />
        <div class="frame-decoration"></div>
      </div>
      <div class="stat-card stat-1 glass-card animate-float" style="animation-delay: -1s;">
        <span class="stat-emoji">👨‍🏫</span>
        <div>
          <p class="stat-label">Visionary</p>
          <p class="stat-value">Mentor</p>
        </div>
      </div>
      <div class="stat-card stat-2 glass-card animate-float" style="animation-delay: -2.5s;">
        <span class="stat-emoji">🚀</span>
        <div>
          <p class="stat-label">Inspiring</p>
          <p class="stat-value">Leader</p>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Decorative Background elements -->
  <div class="decor-line"></div>
</section>

<style>
  .hero {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    background: radial-gradient(circle at 0% 0%, #0d2a45 0%, #061525 100%);
  }

  .hero-glow-1 {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 50%;
    height: 50%;
    background: radial-gradient(circle, rgba(253, 185, 19, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-glow-2 {
    position: absolute;
    bottom: -10%;
    left: -10%;
    width: 40%;
    height: 40%;
    background: radial-gradient(circle, rgba(253, 185, 19, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    margin-bottom: 2rem;
    backdrop-filter: blur(10px);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-gold);
    border-radius: 50%;
    position: relative;
  }

  .pulse-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    background-color: var(--color-gold);
    border-radius: 50%;
    opacity: 0.4;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.4; }
    100% { transform: scale(2.5); opacity: 0; }
  }

  .hero-title {
    font-size: clamp(3rem, 7vw, 5rem);
    color: white;
    line-height: 1.05;
    margin-bottom: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .hero-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 3rem;
    max-width: 540px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
    color: var(--color-navy-dark);
    padding: 1.1rem 2.2rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: var(--shadow-gold);
    transition: var(--transition);
  }

  .btn-primary:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 15px 40px rgba(253, 185, 19, 0.4);
  }

  .btn-outline {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: white;
    padding: 1.1rem 2.2rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: var(--transition);
    backdrop-filter: blur(10px);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: white;
    transform: translateY(-4px);
  }

  .hero-image-container {
    position: relative;
    padding: 2rem;
  }

  .image-frame {
    position: relative;
    z-index: 2;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-heavy);
    background: var(--color-navy-light);
  }

  .hero-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    transform: scale(1.01);
    transition: var(--transition-slow);
  }

  .image-frame:hover .hero-img {
    transform: scale(1.05);
  }

  .frame-decoration {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(253, 185, 19, 0.2);
    border-radius: var(--radius-xl);
    pointer-events: none;
    z-index: 3;
  }

  .stat-card {
    position: absolute;
    z-index: 4;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 160px;
  }

  .stat-1 {
    top: 10%;
    left: -15%;
  }

  .stat-2 {
    bottom: 15%;
    right: -5%;
  }

  .stat-emoji {
    font-size: 1.5rem;
  }

  .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    font-weight: 700;
    margin: 0;
  }

  .stat-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-navy-dark);
    margin: 0;
  }

  .decor-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .stat-1 { left: 0; }
    .stat-2 { right: 0; }
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary, .btn-outline {
      width: 100%;
      justify-content: center;
    }
    .hero-title {
      font-size: 2.2rem;
    }
    .hero-description {
      font-size: 1rem;
    }
    .stat-card {
      display: none;
    }
    .hero-image-container {
      padding: 0.5rem;
    }
  }
</style>
