---
---
<section class="hero bg-navy relative overflow-hidden flex items-center min-h-[90vh]">
  <!-- Birthday floating particles -->
  <span class="birthday-particle" style="left:8%;  bottom:15%; animation-delay:0.2s; animation-duration:3.8s;">🎂</span>
  <span class="birthday-particle" style="left:15%; bottom:20%; animation-delay:0.8s; animation-duration:3.2s;">🎈</span>
  <span class="birthday-particle" style="left:5%;  bottom:35%; animation-delay:1.4s; animation-duration:4.1s;">🎉</span>
  <span class="birthday-particle" style="right:6%; bottom:20%; animation-delay:0.5s; animation-duration:3.6s;">⭐</span>
  <span class="birthday-particle" style="right:12%;bottom:30%; animation-delay:1.1s; animation-duration:3.3s;">🎈</span>
  <span class="birthday-particle" style="right:4%; bottom:45%; animation-delay:1.7s; animation-duration:4.0s;">🎂</span>

  <div class="hero-glow-1"></div>
  <div class="hero-glow-2"></div>
  
  <div class="container relative z-10 hero-grid">
    <div class="hero-content animate-fade-left">
      <h1 class="hero-title">
        <span class="animate-word" style="animation-delay:0.15s;">Happy</span>
        <span class="animate-word" style="animation-delay:0.30s;"> Birthday</span>
        <br />
        <span class="animate-word italic" style="animation-delay:0.50s;"><span class="shimmer-once">SK Chaudhary Sir</span></span>
      </h1>
      <p class="hero-description animate-fade-in delay-3">
      Co-Founder of Safex Group. Your vision is the light that guides us toward a brighter future in tech.
      </p>
      <div class="hero-actions">
        <a href="#gallery" class="btn-primary animate-fade-in delay-4">
          <span>View Gallery</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
        <a href="#videos" class="btn-outline animate-fade-in" style="animation-delay:0.75s; opacity:0;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <span>Watch Wishes</span>
        </a>
      </div>
    </div>
    
    <div class="hero-image-container animate-fade-right delay-2">
      <div class="image-frame-wrapper photo-spin">
        <div class="image-frame animate-float">
          <img src="/sir.png" alt="SK Chaudhary Sir" class="hero-img" />
          <div class="frame-decoration"></div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Decorative Background elements -->
  <div class="decor-line"></div>
</section>

<style>
  .hero {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    background: radial-gradient(circle at 0% 0%, #0d2a45 0%, #061525 100%);
  }

  .hero-glow-1 {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 50%;
    height: 50%;
    background: radial-gradient(circle, rgba(253, 185, 19, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-glow-2 {
    position: absolute;
    bottom: -10%;
    left: -10%;
    width: 40%;
    height: 40%;
    background: radial-gradient(circle, rgba(253, 185, 19, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    margin-bottom: 2rem;
    backdrop-filter: blur(10px);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-gold);
    border-radius: 50%;
    position: relative;
  }

  .pulse-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    background-color: var(--color-gold);
    border-radius: 50%;
    opacity: 0.4;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.4; }
    100% { transform: scale(2.5); opacity: 0; }
  }

  .hero-title {
    font-size: clamp(3rem, 7vw, 5rem);
    color: white;
    line-height: 1.05;
    margin-bottom: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .hero-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 3rem;
    max-width: 540px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
    color: var(--color-navy-dark);
    padding: 1.1rem 2.2rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: var(--shadow-gold);
    transition: var(--transition);
  }

  .btn-primary:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 15px 40px rgba(253, 185, 19, 0.4);
  }

  .btn-outline {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: white;
    padding: 1.1rem 2.2rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: var(--transition);
    backdrop-filter: blur(10px);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: white;
    transform: translateY(-4px);
  }

  .image-frame-wrapper {
    position: relative;
    z-index: 2;
    border-radius: var(--radius-xl);
  }

  /* ─── Spinning golden border + glow ─── */
  .photo-spin {
    padding: 3px;
    overflow: hidden;
    animation: goldenGlow 3s ease-in-out infinite;
  }

  .photo-spin::before {
    content: '';
    position: absolute;
    inset: -100%;
    background: conic-gradient(
      from 0deg,
      transparent 0%,
      transparent 25%,
      var(--color-gold) 40%,
      var(--color-gold-light) 48%,
      white 50%,
      var(--color-gold-light) 52%,
      var(--color-gold) 60%,
      transparent 75%,
      transparent 100%
    );
    animation: spinBorder 3s linear infinite;
    z-index: 0;
  }

  .photo-spin::after {
    content: '';
    position: absolute;
    inset: 3px;
    background: var(--color-navy-dark);
    border-radius: calc(var(--radius-xl) - 2px);
    z-index: 1;
  }

  .photo-spin .image-frame {
    position: relative;
    z-index: 2;
  }

  @keyframes spinBorder {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes goldenGlow {
    0%, 100% {
      box-shadow:
        0 0 25px rgba(253, 185, 19, 0.35),
        0 0 60px rgba(253, 185, 19, 0.15),
        0 25px 60px rgba(0, 0, 0, 0.4);
    }
    50% {
      box-shadow:
        0 0 50px rgba(253, 185, 19, 0.65),
        0 0 100px rgba(253, 185, 19, 0.3),
        0 25px 60px rgba(0, 0, 0, 0.4);
    }
  }

  .hero-image-container {
    position: relative;
    padding: 2rem;
  }

  .image-frame {
    position: relative;
    z-index: 2;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-heavy);
    background: var(--color-navy-light);
  }

  .hero-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    transform: scale(1.01);
    transition: var(--transition-slow);
  }

  .image-frame:hover .hero-img {
    transform: scale(1.05);
  }

  .frame-decoration {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(253, 185, 19, 0.2);
    border-radius: var(--radius-xl);
    pointer-events: none;
    z-index: 3;
  }

  .stat-card {
    position: absolute;
    z-index: 4;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 160px;
  }

  .stat-1 {
    top: 10%;
    left: -15%;
  }

  .stat-2 {
    bottom: 15%;
    right: -5%;
  }

  .stat-emoji {
    font-size: 1.5rem;
  }

  .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    font-weight: 700;
    margin: 0;
  }

  .stat-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-navy-dark);
    margin: 0;
  }

  .decor-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .stat-1 { left: 0; }
    .stat-2 { right: 0; }
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary, .btn-outline {
      width: 100%;
      justify-content: center;
    }
    .hero-title {
      font-size: 2.2rem;
    }
    .hero-description {
      font-size: 1rem;
    }
    .stat-card {
      display: none;
    }
    .hero-image-container {
      padding: 0.5rem;
    }
    .birthday-particle {
      font-size: 1rem;
    }
  }
</style>
