---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StudentGallery from '../components/StudentGallery.astro';
import Notes from '../components/Notes.astro';
import Videos from '../components/Videos.astro';
---

<Layout title="Happy Birthday SK Chaudhary Sir | CodeYogi Tribute">
	<!-- Premium Navbar -->
	<nav class="site-nav" id="site-nav">
		<div class="container nav-inner">
			<a href="#" class="nav-logo">
				Code<span>Yogi</span>
			</a>

			<div class="nav-links">
				<a href="#" class="nav-link active">Home</a>
				<a href="#videos" class="nav-link">Videos</a>
				<a href="#notes" class="nav-link">Notes</a>
				<a href="#gallery" class="nav-link">Gallery</a>
			</div>

			<div class="nav-actions">
				<a href="#gallery" class="nav-cta">
					<span>🎂</span> Explore
				</a>
			</div>

			<button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>

		<!-- Mobile Menu -->
		<div class="mobile-menu" id="mobile-menu">
			<a href="#" class="mobile-link">Home</a>
			<a href="#gallery" class="mobile-link">Gallery</a>
			<a href="#notes" class="mobile-link">Notes</a>
			<a href="#videos" class="mobile-link">Videos</a>
		</div>
	</nav>

	<main>
		<Hero />
		<hr class="section-divider" />
		<Videos />
		<hr class="section-divider" />
		<Notes />
		<hr class="section-divider" />
		<StudentGallery />

		<!-- Final Wish Section -->
		<section class="final-wish" id="final-wish">
			<!-- Pulsing rings -->
			<div class="wish-ring wish-ring-1"></div>
			<div class="wish-ring wish-ring-2"></div>
			<div class="wish-ring wish-ring-3"></div>
			<!-- Background glow -->
			<div class="wish-bg"></div>
			<!-- Floating particles -->
			<span class="wish-particle" style="top:10%;left:7%;font-size:1.8rem;animation-delay:0s">✨</span>
			<span class="wish-particle" style="top:20%;right:9%;font-size:1.3rem;animation-delay:0.8s">⭐</span>
			<span class="wish-particle" style="top:68%;left:5%;font-size:2rem;animation-delay:1.4s">🌟</span>
			<span class="wish-particle" style="top:72%;right:7%;font-size:1.5rem;animation-delay:0.4s">✨</span>
			<span class="wish-particle" style="top:42%;left:3%;font-size:1.1rem;animation-delay:2s">💫</span>
			<span class="wish-particle" style="top:33%;right:4%;font-size:1.4rem;animation-delay:1s">⭐</span>
			<span class="wish-particle" style="top:55%;left:13%;font-size:1rem;animation-delay:1.8s">✨</span>
			<span class="wish-particle" style="top:22%;right:16%;font-size:1.1rem;animation-delay:1.6s">💫</span>

			<div class="container wish-inner">
				<div class="wish-badge wish-item">🎉 A Heartfelt Wish</div>
				<h2 class="wish-title wish-item">
					Once Again, <br />
					<span class="wish-gold-text">Happy Birthday Sir!</span>
				</h2>
				<div class="wish-divider wish-item"></div>
				<p class="wish-text wish-item">
					Your vision and dedication have changed countless lives. Today we celebrate the incredible person you are.
				</p>
				<div class="wish-emojis wish-item">
					<span class="wish-emoji" style="animation-delay:0s">🎂</span>
					<span class="wish-emoji" style="animation-delay:0.2s">🎉</span>
					<span class="wish-emoji" style="animation-delay:0.4s">🎈</span>
					<span class="wish-emoji" style="animation-delay:0.6s">🥳</span>
					<span class="wish-emoji" style="animation-delay:0.8s">🎁</span>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	/* ─── Navbar ─── */
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(6, 21, 37, 0.85);
		backdrop-filter: blur(24px) saturate(1.5);
		-webkit-backdrop-filter: blur(24px) saturate(1.5);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		transition: var(--transition);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 1rem;
		padding-bottom: 1rem;
	}

	.nav-logo {
		font-family: var(--font-serif);
		font-size: 1.6rem;
		font-weight: 700;
		color: white;
		letter-spacing: -0.01em;
	}

	.nav-logo span {
		color: var(--color-gold);
	}

	.nav-links {
		display: flex;
		gap: 0.5rem;
	}

	.nav-link {
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.85rem;
		font-weight: 500;
		padding: 0.5rem 1rem;
		border-radius: var(--radius-full);
		transition: var(--transition-fast);
		letter-spacing: 0.02em;
	}

	.nav-link:hover,
	.nav-link.active {
		color: white;
		background: rgba(255, 255, 255, 0.08);
	}

	.nav-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
		color: var(--color-navy-dark);
		font-size: 0.85rem;
		font-weight: 700;
		padding: 0.6rem 1.5rem;
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-gold);
		transition: var(--transition);
	}

	.nav-cta:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 40px rgba(253, 185, 19, 0.35);
	}

	@media (max-width: 1024px) {
		.nav-links {
			gap: 0.25rem;
		}
		.nav-link {
			padding: 0.5rem 0.75rem;
			font-size: 0.8rem;
		}
	}

	.site-nav.scrolled {
		padding-top: 0;
		padding-bottom: 0;
		background: rgba(6, 21, 37, 0.98);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
		border-bottom-color: rgba(253, 185, 19, 0.1);
	}

	.site-nav.scrolled .nav-inner {
		padding-top: 0.75rem;
		padding-bottom: 0.75rem;
	}

	/* Hamburger */
	.nav-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
	}

	.nav-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background: white;
		border-radius: 2px;
		transition: var(--transition-fast);
	}

	/* Mobile Menu */
	.mobile-menu {
		display: none;
		flex-direction: column;
		padding: 0 2rem 1.5rem;
		gap: 0.25rem;
	}

	.mobile-link {
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.95rem;
		font-weight: 500;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-sm);
		transition: var(--transition-fast);
	}

	.mobile-link:hover {
		color: white;
		background: rgba(255, 255, 255, 0.06);
	}

	@media (max-width: 768px) {
		.nav-links,
		.nav-cta {
			display: none;
		}

		.nav-toggle {
			display: flex;
		}

		.mobile-menu {
			max-height: 0;
			overflow: hidden;
			transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
			opacity: 0;
			transform: translateY(-10px);
			padding: 0;
		}

		.mobile-menu.open {
			max-height: 300px;
			opacity: 1;
			transform: translateY(0);
			padding: 0.5rem 2rem 2rem;
			display: flex;
		}
	}

	/* ─── Final Wish ─── */
	.final-wish {
		background: var(--color-cream);
		padding: 9rem 0;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.wish-bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at 30% 50%, rgba(253, 185, 19, 0.08) 0%, transparent 60%),
			radial-gradient(ellipse at 70% 50%, rgba(11, 34, 57, 0.04) 0%, transparent 60%);
		pointer-events: none;
		animation: wishGlowPulse 4s ease-in-out infinite;
	}

	@keyframes wishGlowPulse {
		0%, 100% { opacity: 0.7; }
		50%       { opacity: 1; }
	}

	/* Expanding rings */
	.wish-ring {
		position: absolute;
		top: 50%;
		left: 50%;
		border-radius: 50%;
		border: 1px solid rgba(11, 34, 57, 0.08);
		pointer-events: none;
		animation: ringExpand 5s ease-out infinite;
	}

	.wish-ring-1 { width: 280px; height: 280px; animation-delay: 0s; }
	.wish-ring-2 { width: 520px; height: 520px; animation-delay: 1.7s; }
	.wish-ring-3 { width: 780px; height: 780px; animation-delay: 3.3s; }

	@keyframes ringExpand {
		0%   { transform: translate(-50%, -50%) scale(0.6); opacity: 0.7; }
		100% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
	}

	/* Floating particles */
	.wish-particle {
		position: absolute;
		pointer-events: none;
		user-select: none;
		opacity: 0.55;
		animation: particleDrift 4.5s ease-in-out infinite;
	}

	@keyframes particleDrift {
		0%, 100% { transform: translateY(0)    rotate(0deg)  scale(1);    }
		33%       { transform: translateY(-16px) rotate(10deg) scale(1.12); }
		66%       { transform: translateY(-7px)  rotate(-6deg) scale(0.93); }
	}

	.wish-inner {
		position: relative;
		z-index: 1;
	}

	/* Badge */
	.wish-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, rgba(253, 185, 19, 0.12), rgba(253, 185, 19, 0.04));
		border: 1px solid rgba(253, 185, 19, 0.2);
		color: var(--color-gold-dark);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.6rem 1.75rem;
		border-radius: var(--radius-full);
		margin-bottom: 2rem;
		position: relative;
		overflow: hidden;
	}

	.wish-badge::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.25) 50%, transparent 100%);
		transform: translateX(-100%);
		animation: badgeShine 3.5s ease-in-out infinite;
	}

	@keyframes badgeShine {
		0%       { transform: translateX(-100%); }
		40%, 100% { transform: translateX(150%); }
	}

	/* Title */
	.wish-title {
		font-size: clamp(2.5rem, 6vw, 5rem);
		margin-bottom: 1.25rem;
		letter-spacing: -0.02em;
		color: var(--color-navy);
		line-height: 1.1;
	}

	/* Animated gold gradient text */
	.wish-gold-text {
		background: linear-gradient(90deg, #E5A100 0%, #FDB913 30%, #FFD54F 50%, #FDB913 70%, #E5A100 100%);
		background-size: 200% auto;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: goldFlow 3s linear infinite;
	}

	@keyframes goldFlow {
		0%   { background-position: 0% center; }
		100% { background-position: 200% center; }
	}

	/* Glowing divider */
	.wish-divider {
		width: 80px;
		height: 2px;
		background: linear-gradient(90deg, transparent, #FDB913, transparent);
		margin: 0 auto 2rem;
		animation: dividerPulse 2.5s ease-in-out infinite;
	}

	@keyframes dividerPulse {
		0%, 100% { width: 80px;  box-shadow: 0 0 8px rgba(253,185,19,0.4); }
		50%       { width: 120px; box-shadow: 0 0 20px rgba(253,185,19,0.8); }
	}

	/* Text */
	.wish-text {
		font-size: 1.15rem;
		color: var(--color-text-secondary);
		max-width: 560px;
		margin: 0 auto 3.5rem;
		line-height: 1.8;
	}

	/* Emojis */
	.wish-emojis {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}

	.wish-emoji {
		font-size: 2.8rem;
		display: inline-block;
		animation: emojiDance 2.2s ease-in-out infinite;
		cursor: default;
		user-select: none;
		filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
	}

	@keyframes emojiDance {
		0%, 100% { transform: translateY(0)    scale(1)    rotate(0deg);  }
		25%       { transform: translateY(-16px) scale(1.18) rotate(-6deg); }
		75%       { transform: translateY(-8px)  scale(1.09) rotate(4deg);  }
	}

	.wish-emoji:hover {
		animation: emojiPop 0.45s ease forwards;
	}

	@keyframes emojiPop {
		0%   { transform: scale(1)   rotate(0deg); }
		50%  { transform: scale(1.5) rotate(180deg); }
		100% { transform: scale(1)   rotate(360deg); }
	}

	/* Scroll-reveal — pure CSS, no JS dependency */
	.wish-item {
		animation: wishReveal 0.7s ease both;
	}

	@keyframes wishReveal {
		from { opacity: 0; transform: translateY(28px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	.wish-item:nth-child(1) { animation-delay: 0.1s; }
	.wish-item:nth-child(2) { animation-delay: 0.3s; }
	.wish-item:nth-child(3) { animation-delay: 0.5s; }
	.wish-item:nth-child(4) { animation-delay: 0.65s; }
	.wish-item:nth-child(5) { animation-delay: 0.8s; }

	@media (max-width: 768px) {
		.final-wish { padding: 6rem 0; }
		.wish-text  { font-size: 1rem; }
		.wish-emojis { gap: 1rem; }
		.wish-emoji  { font-size: 2.2rem; }
		.wish-ring-3 { display: none; }
	}

	@media (max-width: 480px) {
		.final-wish  { padding: 4rem 0; }
		.wish-emojis { gap: 0.75rem; }
		.wish-emoji  { font-size: 1.8rem; }
		.wish-ring-2 { display: none; }
	}
</style>

<script>
	// Mobile menu toggle
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('mobile-menu');
	
	toggle?.addEventListener('click', () => {
		menu?.classList.toggle('open');
	});

	// Close mobile menu on link click
	document.querySelectorAll('.mobile-link').forEach(link => {
		link.addEventListener('click', () => {
			menu?.classList.remove('open');
		});
	});

	// Navbar scroll effect
	const nav = document.getElementById('site-nav');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 50) {
			nav?.classList.add('scrolled');
		} else {
			nav?.classList.remove('scrolled');
		}
	});

	// Confetti Effect
	import confetti from 'https://cdn.skypack.dev/canvas-confetti';
	
	const colors = ['#FDB913', '#FFD54F', '#FFFFFF', '#0B2239'];

	function fireConfetti() {
		// Center burst
		confetti({ particleCount: 100, spread: 70, origin: { x: 0.5, y: 0.55 }, colors });
		// Top-left cannon
		confetti({ particleCount: 80, angle: 55,  spread: 60, origin: { x: 0, y: 0.1 }, colors, gravity: 1.2 });
		// Top-right cannon
		confetti({ particleCount: 80, angle: 125, spread: 60, origin: { x: 1, y: 0.1 }, colors, gravity: 1.2 });
	}

	// Fire on load
	window.addEventListener('load', () => {
		setTimeout(fireConfetti, 1000);
	});

	// Confetti when final-wish section enters viewport
	const wishSection = document.getElementById('final-wish');
	let wishTriggered = false;

	const wishObserver = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting && !wishTriggered) {
				wishTriggered = true;
				setTimeout(fireConfetti, 400);
			}
		});
	}, { threshold: 0.1 });

	if (wishSection) wishObserver.observe(wishSection);

	// Fire on click too
	wishSection?.addEventListener('click', fireConfetti);
</script>
